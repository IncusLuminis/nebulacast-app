{
  "name": "nebulacast-app",
  "private": true,
  "description": "Staging site + Cloudflare Pages Functions (api/astro-weather, geocode, revgeo)",
  "scripts": {
    "build:functions": "node scripts/build-functions.mjs",
    "build:helio": "node scripts/build-helio.mjs",
    "watch:helio": "node scripts/build-helio.mjs --watch",
    "build:lunar": "node scripts/build-lunar.mjs",
    "test:lunar": "node --test tests/lunar.test.mjs",
    "test:browser": "playwright test",
    "test:provider-contracts": "node scripts/test-provider-contracts.mjs",
    "test:ephemeris-contract": "node scripts/test-ephemeris-contract.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260313.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  }
}
