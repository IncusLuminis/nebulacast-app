{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebulacast.app/schemas/v2/dataset-envelope.v1.schema.json",
  "title": "Nebulacast DatasetEnvelope v1",
  "allOf": [
    { "$ref": "envelope-core.v1.schema.json" },
    {
      "type": "object",
      "required": ["schema_version", "release_set_id", "input_refs", "freshness", "status"],
      "properties": {
        "schema_version": { "const": "nebulacast.dataset-envelope.v1" },
        "release_set_id": { "type": "string", "minLength": 1 },
        "input_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "algorithm_version": { "type": "string", "minLength": 1 },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "policy_version"],
          "properties": {
            "state": { "enum": ["fresh", "stale", "expired"] },
            "policy_version": { "type": "string", "minLength": 1 },
            "source_age_seconds": { "type": "number", "minimum": 0 }
          }
        },
        "status": { "enum": ["ok", "partial", "unavailable", "error"] },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        }
      },
      "$defs": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "outside_coverage",
                "unsupported_location",
                "upstream_failure",
                "unknown_visibility",
                "snapshot_expired",
                "invalid_request"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "component": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
