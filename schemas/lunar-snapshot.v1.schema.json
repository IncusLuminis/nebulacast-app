{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebulacast.app/schemas/lunar-snapshot.v1.schema.json",
  "title": "Nebulacast LunarSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "computed_at_utc", "location_key", "location", "source", "freshness", "status", "lunar"],
  "properties": {
    "schema_version": { "const": "lunar-snapshot.v1" },
    "computed_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "location_key": { "type": "string", "minLength": 1 },
    "location": { "type": "object", "additionalProperties": false, "required": ["lat", "lon", "timezone"], "properties": { "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lon": { "type": "number", "minimum": -180, "maximum": 180 }, "timezone": { "type": "string", "minLength": 1 } } },
    "source": { "type": "string", "minLength": 1 },
    "freshness": { "enum": ["live", "generated", "stale"] },
    "status": { "enum": ["available", "stale", "unavailable"] },
    "lunar": { "type": "object", "additionalProperties": false, "required": ["cycle_phase", "illuminated_fraction", "illuminated_percent", "waxing", "phase_name", "emoji"], "properties": { "cycle_phase": { "type": "number", "minimum": 0, "maximum": 1 }, "illuminated_fraction": { "type": "number", "minimum": 0, "maximum": 1 }, "illuminated_percent": { "type": "number", "minimum": 0, "maximum": 100 }, "waxing": { "type": "boolean" }, "phase_name": { "type": "string", "minLength": 1 }, "emoji": { "type": "string", "minLength": 1 }, "alt_deg": { "type": ["number", "null"] }, "az_deg": { "type": ["number", "null"] } } }
  }
}
